# Target
CONFIG_IDF_TARGET="esp32s3"

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# USB console (primary console over USB-Serial/JTAG for stdin/stdout)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n

# USB (native USB OTG for CDC)
CONFIG_ESP_PHY_ENABLE_USB=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_RX_BUFSIZE=256
CONFIG_TINYUSB_CDC_TX_BUFSIZE=512

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Memory
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# CPU frequency
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# Power management (F4.3): automatic light sleep when all tasks idle
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# Bluetooth (NimBLE) - observer role for BLE scanning; the central role is
# pulled in by BLE_CONN_ENABLED via Kconfig select (F2.4), so it is not
# pinned here.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_DEFAULT=y

# BLE connection feature (F2.4): optional GATT client, default on.
# Set =n for the minimal passive-sniffer build (CONN answers -451).
CONFIG_BLE_CONN_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# Disable WiFi to save RAM (~20KB)
CONFIG_ESP_WIFI_ENABLED=n

# LittleFS filesystem
CONFIG_LITTLEFS_ENABLED=y
